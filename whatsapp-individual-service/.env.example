# Porta HTTP do serviço (a Railway define PORT automaticamente — só use um
# valor fixo para rodar local).
PORT=3100

# MESMO valor configurado na Vercel como WHATSAPP_INDIVIDUAL_SERVICE_SECRET.
# Usado nos dois sentidos: para validar as chamadas que o Next.js faz para cá
# (connect/status/disconnect/send) e para assinar as chamadas que este
# serviço faz para o webhook do Next.js. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_INDIVIDUAL_SERVICE_SECRET=

# URL base do site (Vercel) — este serviço faz POST para
# {APP_WEBHOOK_URL}/api/webhooks/whatsapp-individual quando chega mensagem
# nova ou muda o status/QR de uma sessão.
APP_WEBHOOK_URL=https://SEU-DOMINIO.vercel.app

# Mesmo projeto Supabase do CRM (painel do projeto > Configurações da API).
# service_role: acesso total à tabela whatsapp_individual_sessions.
SUPABASE_URL=https://tshhasbbchjcvhoyizoo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave para cifrar (AES-256-GCM) as credenciais do WhatsApp (Baileys) antes
# de gravar no banco — 32 bytes em HEX (64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA reaproveite esta chave em outro lugar, e NUNCA a perca: sem ela as
# credenciais salvas ficam ilegíveis e todo corretor precisa escanear o QR
# de novo.
SESSION_ENCRYPTION_KEY=

# Opcional: nível de log do Baileys (silent | error | warn | info | debug).
# Deixe "silent" em produção — o log padrão do Baileys é bem verboso.
BAILEYS_LOG_LEVEL=silent
