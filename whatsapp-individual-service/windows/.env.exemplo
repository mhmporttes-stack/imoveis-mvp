# Configuracao do servico do WhatsApp no PC (copiada para C:\MMWhatsApp\config\.env pelo INSTALAR).
# NUNCA coloque valores neste arquivo de exemplo nem cole os valores no chat.
# Copie cada valor do Railway (servico > Variables), sem aspas e sem espacos.

# URL do CRM (a mesma que estava no Railway). Ex.: https://www.matheusmachadoimoveis.com.br
APP_WEBHOOK_URL=

# MESMO valor da variavel de mesmo nome na Vercel.
WHATSAPP_INDIVIDUAL_SERVICE_SECRET=

# 64 caracteres (0-9, a-f). Copie a do Railway: com outra chave todo corretor precisa escanear o QR de novo.
SESSION_ENCRYPTION_KEY=

# Porta local (o tunel do Tailscale aponta para ela).
PORT=3100

# Opcionais (valores ja sugeridos para o PC)
BAILEYS_LOG_LEVEL=silent
# Boot do PC sem internet: espera ate 10 min pelo lease antes de seguir sem ele (padrao do codigo: 90 s).
WHATSAPP_LEASE_UNAVAILABLE_GRACE_MS=600000
# Nunca coloque WHATSAPP_LEASE_DISABLED=true aqui (permitiria duas instancias juntas).
# Outras opcionais lidas pelo servico (deixe sem definir para usar o padrao do codigo):
# WHATSAPP_HISTORY_SYNC_ENABLED, WHATSAPP_RESUME_SETTLE_MS, WHATSAPP_RECONCILE_STALE_MS,
# WHATSAPP_RECONNECT_MAX_RETRIES, WHATSAPP_RECONNECT_STABLE_MS, WHATSAPP_RECONNECT_DROP_LIMIT
