{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/**)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx next *)",
      "Bash(python3 *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git merge *)",
      "Bash(git rebase origin/*)",
      "Bash(git pull --rebase *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(git restore *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(diff *)",
      "Bash(ps *)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)",
      "Bash(pnpm dlx vercel --prod --yes)",
      "Bash(pnpm dlx vercel ls*)",
      "Bash(pnpm dlx vercel inspect *)",
      "Bash(pnpm dlx vercel logs *)",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__apply_migration"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git checkout -- *)",
      "Bash(git restore --staged *)",
      "Bash(git rebase -i*)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref -d *)",
      "Bash(rm *)",
      "Bash(pnpm dlx vercel env *)",
      "Bash(pnpm dlx vercel rm *)",
      "Bash(pnpm dlx vercel remove *)",
      "Bash(pnpm dlx vercel domains *)",
      "Bash(pnpm dlx vercel secrets *)",
      "Bash(pnpm dlx vercel project rm *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Edit(/.env*)",
      "Edit(/**/.env*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__create_project",
      "mcp__Supabase__deploy_edge_function"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__execute_sql|mcp__Supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-sql.mjs\"",
            "timeout": 10,
            "statusMessage": "Conferindo SQL de alto risco..."
          }
        ]
      }
    ]
  }
}
