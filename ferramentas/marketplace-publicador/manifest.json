{
  "manifest_version": 3,
  "name": "Publicador Marketplace — Matheus Machado Corretor de Imóveis",
  "short_name": "Publicador Marketplace",
  "version": "1.9.3",
  "description": "Publica no Marketplace os anúncios aprovados no CRM e espelha no CRM as conversas do Marketplace.",
  "minimum_chrome_version": "116",
  "icons": { "48": "icones/icon-192-mm.png", "128": "icones/icon-192-mm.png" },
  "action": { "default_popup": "popup.html", "default_title": "Publicador Marketplace", "default_icon": "icones/icon-192-mm.png" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications", "tabs", "scripting", "debugger", "power"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.matheusmachadoimoveis.com.br/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": ["https://*/*", "<all_urls>"]
}
