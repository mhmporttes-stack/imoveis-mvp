# whatsapp-dispatch-service — só NOMES. Valores reais ficam fora do git (.env local / painel da hospedagem).
NODE_ENV=
LOG_LEVEL=
PORT=3031
# Postgres: padrão = banco do CRM (Supabase, conexão em modo sessão, schema wa_dispatch). Local: docker compose.
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=
POSTGRES_PASSWORD=
REDIS_URL=
REDIS_PASSWORD=
QUEUE_PREFIX=
# Tokens da API (mínimo 32 caracteres cada)
CRM_API_TOKEN=
ADMIN_API_TOKEN=
READONLY_API_TOKEN=
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=
# Operação
WORKER_CONCURRENCY=
SCHEDULER_INTERVAL_MS=
SCHEDULER_BATCH_SIZE=
RETRY_BASE_DELAY_MS=
RETRY_MAX_DELAY_MS=
MAX_SEND_ATTEMPTS=
SEND_TIMEOUT_MS=
SENDING_LOCK_MS=
UNKNOWN_VERIFICATION_WINDOW_MS=
INSTANCE_HEALTH_INTERVAL_MS=
DEFAULT_COUNTRY_CODE=
OPT_OUT_KEYWORDS=
# WhatsApp Cloud API (Meta)
WA_GRAPH_BASE_URL=
WA_GRAPH_API_VERSION=
WA_APP_ID=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_CLOUD_ACCESS_TOKEN=
# Token por número (opcional): o NOME da variável vai em credential_ref da instância. Ex.:
WA_TOKEN_NUMERO_1=
WA_TOKEN_NUMERO_2=
# Provedor opcional: whatsapp-individual-service existente
WHATSAPP_INDIVIDUAL_SERVICE_URL=
WHATSAPP_INDIVIDUAL_SERVICE_SECRET=
# Consentimento (fonte confiável)
CONSENT_VERIFIER=
CRM_DATABASE_URL=
CRM_DB_SCHEMA=
CONSENT_CRM_ACCEPTED_PURPOSES=
CRM_CONSENT_VERIFY_URL=
CRM_CONSENT_VERIFY_TOKEN=
CONSENT_VERIFY_TIMEOUT_MS=
