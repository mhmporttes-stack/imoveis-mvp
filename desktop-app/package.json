{
  "name": "mm-crm-desktop",
  "productName": "CRM Matheus Machado",
  "version": "1.2.0",
  "private": true,
  "description": "App de desktop do dono (Windows): abre o CRM de produção com o Henry sempre ligado.",
  "author": "Matheus Machado Corretor de Imóveis",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "models": "node scripts/fetch-models.js",
    "dist:portable": "node scripts/fetch-models.js && electron-builder --win zip portable --x64",
    "dist:nsis": "node scripts/fetch-models.js && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.matheusmachadoimoveis.crm",
    "productName": "CRM Matheus Machado",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon-512-mm.png",
      "artifactName": "CRM-Matheus-Machado-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "CRM-Matheus-Machado-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "CRM Matheus Machado"
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*",
          "!.download/**",
          "!modelos.ok"
        ]
      }
    ]
  },
  "dependencies": {
    "vosk-browser": "0.0.8"
  }
}
