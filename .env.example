NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=mhmporttes@gmail.com
ADMIN_EMAILS=mhmporttes@gmail.com,forbencke@gmail.com
ENABLE_SQLITE=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SIMULATION_NOTIFICATION_EMAIL=
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
# Hash SHA-256 (hex) do token que o pg_cron do Supabase envia no header Authorization.
# Gere com: node -e "console.log(require('crypto').createHash('sha256').update('SEU_TOKEN_AQUI').digest('hex'))"
SUPABASE_CRON_TOKEN_HASH=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=pt_BR
# Web Push (notificações push do PWA). Gere com lib/web-push.js -> generateVapidKeys().
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mhmporttes@gmail.com
# Meta Pixel (páginas públicas: /simulacao, /captacao etc. — nunca /admin) +
# Conversions API (envio server-side, mais confiável, do mesmo evento "Lead").
# ID do pixel: Gerenciador de Eventos > sua fonte de dados > Configurações.
NEXT_PUBLIC_META_PIXEL_ID=
# Token de acesso da Conversions API: Gerenciador de Eventos > sua fonte de
# dados > Configurações > Conversions API > Gerar token de acesso.
META_CONVERSIONS_API_ACCESS_TOKEN=

# Meta Ads (Gestão de Tráfego, Fase 1 — SOMENTE LEITURA, ads_read).
# Token SEPARADO de WHATSAPP_ACCESS_TOKEN e de META_CONVERSIONS_API_ACCESS_TOKEN
# (escopos diferentes) — token de um System User com acesso explícito à Ad
# Account no Business Manager (Configurações do negócio > Contas de anúncio
# > Atribuir pessoas). Gerar token: Business Manager > Usuários do sistema
# > [o system user] > Gerar novo token > escopo ads_read.
META_ADS_ACCESS_TOKEN=
# Id da conta de anúncios, com ou sem o prefixo "act_" (aceito dos dois jeitos).
META_ADS_AD_ACCOUNT_ID=
# Versão da Graph/Marketing API — confirmar a versão vigente e suportada no
# momento da implementação em developers.facebook.com/docs/graph-api/changelog.
META_ADS_GRAPH_API_VERSION=v23.0
# Data (YYYY-MM-DD) a partir da qual o backfill inicial (POST autenticado
# em /api/admin/meta-ads/backfill, admin geral) deve importar histórico.
# Deixe vazio para não rodar backfill.
META_ADS_BACKFILL_START_DATE=
# Quantos dias pra trás a consolidação diária ressincroniza, pra incorporar
# ajuste retroativo de atribuição da Meta. Default no código: 10.
META_ADS_SYNC_WINDOW_DAYS=10

# Alexa (falas espontâneas via Voice Monkey) — desligado por padrão
ALEXA_VOICE_ENABLED=false
VOICEMONKEY_TOKEN=
VOICEMONKEY_DEVICE=
# Opcionais: VOICEMONKEY_LANGUAGE (padrão pt-BR), VOICEMONKEY_VOICE

# Alexa — skill privada "Central Machado" (consulta por voz, somente leitura)
ALEXA_SKILL_ENABLED=false
ALEXA_SKILL_ID=
ALEXA_ALLOWED_USER_IDS=

# Verificação em duas etapas do dono (/admin/seguranca). Segredo TOTP cifrado com
# CRM_SECRETS_ENCRYPTION_KEY (HEX de 32 bytes, lib/secrets-crypto.js — o mesmo dos tokens do Google Contacts).
# ADMIN_TWO_FACTOR_COOKIE_SECRET é OPCIONAL: chave HMAC dos cookies do 2º fator; sem ela é derivada
# de SUPABASE_SERVICE_ROLE_KEY. Trocar a chave só faz o sistema pedir o código de novo.
CRM_SECRETS_ENCRYPTION_KEY=
ADMIN_TWO_FACTOR_COOKIE_SECRET=
# Chat (2026-10-10): resumo da conversa por IA usa ANTHROPIC_API_KEY (modelo opcional abaixo);
# transcrição de áudio usa OPENAI_API_KEY — sem ela o botão "Transcrever" não aparece.
ANTHROPIC_CHAT_SUMMARY_MODEL=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=
